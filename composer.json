{
  "name": "maildesk/maildesk",
  "description": "MailDesk - Internal Contact Mailer",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "ext-mbstring": "*",
    "phpmailer/phpmailer": "^6.9",
    "nikic/fast-route": "^1.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": { "phpunit/phpunit": "^11.0" },
  "autoload": {
    "psr-4": { "MailDesk\\": "src/" },
    "files": ["src/Presentation/View/helpers.php"]
  },
  "autoload-dev": {
    "psr-4": { "MailDesk\\Tests\\": "tests/" }
  },
  "config": { "optimize-autoloader": true }
}
