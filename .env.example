APP_ENV=production
APP_URL=https://maildesk.example.org
# Generate with: php bin/console key:generate
APP_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES

# sqlite (default, zero setup) or mysql
DB_DRIVER=sqlite
DB_PATH=storage/maildesk.sqlite
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=maildesk
# DB_USER=maildesk
# DB_PASSWORD=change-me

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

RATE_LOGIN_MAX=5
RATE_LOGIN_WINDOW_MIN=15
RATE_SEND_PER_MIN=10
RATE_SEND_PER_DAY=200
MAIL_MAX_RECIPIENTS=50
MAIL_TIMEOUT_SECONDS=10

TRUSTED_PROXIES=
LOG_LEVEL=warning
